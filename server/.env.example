# ─── What is .env.example? ─────────────────────────────────────────────────────
# This file is a TEMPLATE for your ".env" file.
#
# A ".env" file holds secret configuration values (passwords, API keys) that
# must never be committed to the git repository. Because of this, everyone
# needs to create their own ".env" file locally.
#
# How to use this file:
#   1. Copy it:   cp .env.example .env
#   2. Fill in your own real values in the new ".env" file.
#   3. Never share or commit your ".env" file.
#
# The ".env" file is listed in ".gitignore" so Git will always ignore it.
# This file (.env.example) IS committed. It acts as documentation so that 
# we know what variables we need to configure.
# ───────────────────────────────────────────────────────────────────────────────


# ─── Server Configuration ──────────────────────────────────────────────────────
# PORT: The network port number that the Express server will listen on.
# The frontend (Vite) is configured to proxy "/api" requests to this port.
# 3000 is a common convention for local backend development.
PORT=3000


# ─── JWT Configuration ─────────────────────────────────────────────────────────
# JWT (JSON Web Token) is used for user authentication. When a user logs in,
# the server creates a signed "token" that proves who they are.
#
# JWT_SECRET: A long, random, private string used to sign and verify tokens.
# Anyone with this secret can forge login tokens, so keep it private!
# For local dev, any random string works. For production, use something long
# and randomly generated (e.g., run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_jwt_secret_here


# ─── Database Configuration ────────────────────────────────────────────────────
# We are using SQLite, which stores the entire database in a single local file.
# Unlike MySQL or PostgreSQL, there is no database server to connect to, just
# a file path. The database file is created automatically by the migration
# script (server/db/migrate.js).
#
# Default location: server/db/database.sqlite
# This file is listed in .gitignore, so it is never committed to the repo.


# ─── SMTP Configuration (Exchange Online) ─────────────────────────────────────
# SMTP (Simple Mail Transfer Protocol) is the standard for sending emails.
# These values configure nodemailer to send emails through UEA's
# Microsoft Exchange Online mail server.
#
# SMTP_HOST: The address of the mail server. Office 365/Exchange Online always
#            uses "smtp.office365.com".
SMTP_HOST=smtp.office365.com

# SMTP_PORT: The port used to connect to the mail server.
#            587 is the standard port for STARTTLS (a secure email connection).
SMTP_PORT=587

# SMTP_USER: An authorised University email address
SMTP_USER=[EMAIL_ADDRESS]

# SMTP_PASS: The password for the email account (may be app-secific for 2FA).
SMTP_PASS=[PASSWORD]
